		"typescript": "^6.0.0",
		"vite": "^8.0.12"
	},
	"dependencies": {
		"@lilydesignsystem/svelte-headless": "^0.4.0",
		"@lilydesignsystem/svelte-share-picker": "^0.2.0",
		"@lilydesignsystem/svelte-text-size-picker": "^0.2.0",
		"@lilydesignsystem/svelte-theme-picker": "^0.2.0"
	},
	"license": "MIT",
	"author": "Joel Parker Henderson <joel@joelparkerhenderson.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/skills-on-ai/skills-on-ai.github.io.git"
